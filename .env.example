# --- Admin mode ---------------------------------------------------------------
# Password for the key in the footer and /admin. Required to sign in.
ADMIN_PASSWORD=
# Optional: separate secret for signing sessions (any long random string).
# Changing it (or the password) signs everyone out.
ADMIN_SECRET=
# The reader's time zone: slots, the schedule and statistics use it.
ADMIN_TZ=Europe/Moscow

# --- Online database ----------------------------------------------------------
# Upstash Redis. On Vercel, add it from Storage → Marketplace → Upstash (Redis):
# the integration sets KV_REST_API_URL and KV_REST_API_TOKEN automatically.
# Without it, requests are stored in UGRIN_DATA_DIR on an own server, and refused
# on Vercel (visitors are then pointed to the messengers).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Folder for requests, analytics and edits without Redis (default: .data).
UGRIN_DATA_DIR=

# Photos uploaded in the live editor. On Vercel: Storage → Blob → Create, then connect it
# to the project (sets BLOB_READ_WRITE_TOKEN). Without it photos go to Redis or .data/media.
BLOB_READ_WRITE_TOKEN=
