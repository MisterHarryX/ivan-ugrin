{
  "name": "ivan-ugrin",
  "version": "1.0.0",
  "description": "Psychologist website template with booking, admin and live content editing",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:pages": "tsc && vite build --mode pages --base / --outDir dist-pages --emptyOutDir",
    "deploy:pages": "npm run build:pages && node scripts/deploy-pages.mjs",
    "preview": "vite preview",
    "typecheck": "tsc",
    "check:content": "node scripts/check-content.ts",
    "check:interactions": "node scripts/check-flows.ts"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@vercel/blob": "^2.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "private": true
}
